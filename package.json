{
    "name": "@itsprofcjs/cjs-rb",
    "version": "2.0.0",
    "description": "Modern React UI components using bulma",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md,css,scss,json}\"",
        "update": "ncu -u && pnpm i"
    },
    "devDependencies": {
        "eslint": "^8.57.0",
        "prettier": "^3.3.2",
        "turbo": "^2.0.6"
    },
    "packageManager": "pnpm@9.5.0",
    "keywords": [
        "react",
        "bulma",
        "ui component",
        "css",
        "html",
        "flexbox",
        "css-framework",
        "design"
    ],
    "author": {
        "name": "Rupesh Kumar Singh",
        "email": "itsprofcjs@gmail.com",
        "url": "https://github.com/itsprofcjs"
    },
    "license": "ISC",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    }
}
